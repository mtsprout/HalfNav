<resources>
    <!-- Android 12+ shows a launch screen before any app code runs, so it can't know if it's
         day or night. A dark navy background with the sunrise icon looks right at both. -->
    <style name="Theme.HalfNav" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:windowSplashScreenBackground">@color/splash</item>
    </style>

    <style name="Theme.HalfNav.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:windowSplashScreenBackground">@color/splash</item>
    </style>
</resources>
